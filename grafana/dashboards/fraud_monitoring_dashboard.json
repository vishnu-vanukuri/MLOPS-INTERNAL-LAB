{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "Total Transaction Requests",
      "type": "stat",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(fraud_http_requests_total{endpoint=\"/predict\"})",
          "legendFormat": "Total Requests",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "unit": "short"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "Fraudulent Transactions Flagged",
      "type": "stat",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(fraud_predictions_total{prediction=\"Fraudulent\"})",
          "legendFormat": "Fraudulent Count",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "short"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "Application Errors",
      "type": "stat",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(fraud_errors_total)",
          "legendFormat": "Total Errors",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "short"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "P95 Inference Latency",
      "type": "gauge",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum(rate(fraud_prediction_latency_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "P95 Latency (ms)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "max": 200,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          },
          "unit": "ms"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "title": "Inference Latency Distribution (P50, P90, P99)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, sum(rate(fraud_prediction_latency_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "P50 Latency (ms)",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.90, sum(rate(fraud_prediction_latency_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "P90 Latency (ms)",
          "refId": "B"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.99, sum(rate(fraud_prediction_latency_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "P99 Latency (ms)",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2
          },
          "unit": "ms"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "title": "Predictions Breakdown: Legitimate vs Fraudulent",
      "type": "piechart",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum by (prediction) (fraud_predictions_total)",
          "legendFormat": "{{prediction}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 7,
      "title": "Incoming Transaction Amount Distribution (INR)",
      "type": "histogram",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(fraud_transaction_amount_inr_bucket[5m])) by (le)",
          "legendFormat": "Amount Bucket <= {{le}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyINR"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 8,
      "title": "Request Throughput & Error Rate",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(fraud_http_requests_total[1m]))",
          "legendFormat": "Total QPS",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(fraud_errors_total[1m]))",
          "legendFormat": "Error Rate",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["fraud-detection", "mlops", "fastapi", "drift-monitoring"],
  "time": {
    "from": "now-15m",
